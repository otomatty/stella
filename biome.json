{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!**/dist",
      "!node_modules",
      "!**/node_modules",
      "!drizzle",
      "!**/drizzle",
      "!**/*.wasm",
      "!.wrangler",
      "!**/.wrangler",
      "!packages/shared/src/problems",
      "!**/packages/shared/src/problems",
      "!packages/content/design-system",
      "!**/packages/content/design-system",
      "!**/apps/web/src/routeTree.gen.ts",
      "!**/apps/web/public/pdf.worker.min.mjs"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "useHookAtTopLevel": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noUnusedTemplateLiteral": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noDebugger": "error",
        "noEmptyBlockStatements": "warn",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noImplicitAnyLet": "error",
        "noSkippedTests": "warn",
        "useAwait": "off",
        "noConsole": {
          "level": "error",
          "options": { "allow": ["assert", "error", "info", "warn"] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/api/scripts/**",
        "**/packages/content/scripts/**",
        "**/packages/shared/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
