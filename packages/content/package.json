{
  "name": "@falcon/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "materials": "node scripts/build.mjs",
    "check": "node scripts/check_vocab.mjs",
    "check:ci": "node scripts/build.mjs --check-only",
    "upload": "bun run scripts/upload-materials.ts",
    "upload:remote": "bun run scripts/upload-materials.ts --remote",
    "upload:thumbnails": "bun run scripts/upload-materials.ts --thumbnails",
    "upload:thumbnails:remote": "bun run scripts/upload-materials.ts --remote --thumbnails"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
