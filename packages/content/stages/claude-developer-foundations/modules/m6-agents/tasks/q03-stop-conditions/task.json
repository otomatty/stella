    "rubric": [
      {
        "id": "preserve-history",
        "criterion": "応答の内容を変えずに履歴へ足し、ツールの結果を呼び出し ID で対応させて応答ごとに1つの user の発言にまとめている",
        "required": true
      },
      {
        "id": "bound-continuation",
        "criterion": "送信回数と応答ごとの費用を記録し、上限、4回目の連続した一時停止、同じツールと入力の2回連続の失敗で次の送信を止めている",
        "required": true
      },
      {
        "id": "return-stop-reason",
        "criterion": "終了の条件を subtype で区別し、end_turn の応答のテキストを成功時だけ result に入れている",
        "required": true
      }
    ],
    "escalateWhen": []
