      "id": "call-query",
      "kind": "code",
      "role": "syntax",
      "title": "依頼して受け取る",
      "code": [
        "// 依頼を渡し、届くメッセージを順に受け取る",
        "for await (const message of query({",
        "  // 依頼と回数の上限を渡す",
        "  prompt, options: { maxTurns: 20 }",
        "// 呼び出しを閉じ、受け取ったものを調べる",
        "})) {",
        "  // 終了結果かどうかを確かめる",
        "  if (message.type === \"result\" &&",
        "      // 正常に終わった場合に限る",
        "      message.subtype === \"success\")",
        "    // 答えを表示する",
        "    show(message.result);",
        "// メッセージを受け取る処理を閉じる",
        "}"
      ],
      "show": true,
      "panel": {
