      "code": [
        "// TypeScript 版 SDK v0.3.317 以降で使う",
        "query({",
        "  // 承認された帳票の更新を頼む",
        "  prompt: \"承認された帳票を更新してください\",",
        "  // オプションにフックを登録する",
        "  options: { hooks: {",
