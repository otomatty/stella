    "rules": [
      { "id": "CR-SCOPE-01", "required": true },
      { "id": "CR-EXPLAIN-01", "required": true }
    ],
    "rubric": [
      {
        "id": "minimal-allow",
        "criterion": "作業の種類に要るツールだけを重ねずに allowedTools に並べ、Bash は決まったコマンドだけに絞り、MCP のツールを名前で 1 つずつ書いている",
        "required": true
      },
      {
        "id": "deny-the-rest",
        "criterion": "permissionMode を dontAsk にし、Bash の要らない作業では disallowedTools で Bash を消し、知らない作業と * の許可をエラーにしている",
        "required": true
      }
    ],
    "escalateWhen": []
  },
