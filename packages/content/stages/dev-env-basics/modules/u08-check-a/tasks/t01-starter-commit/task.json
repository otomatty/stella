{
  "id": "dev-env-basics/u08-check-a/t01-starter-commit",
  "title": "サーバーで確かめて記録する",
  "kind": "integration",
  "pattern": "git-record",
  "skills": {
    "uses": [
      "terminal-location",
      "node-npm-ready",
      "file-save-reopen"
    ],
    "assesses": [
      "local-server-run",
      "git-local-commit"
    ]
  },
  "runner": "git-record",
  "environment": "static-web-01",
  "submit": {
    "files": [
      "index.html"
    ],
    "explanation": true,
    "debuggingRecord": false
  },
  "review": {
    "rubric": [
      {
        "id": "condition-1",
        "criterion": "h1 が「今週のお知らせ」で p が2つ以上ある",
        "required": true
      },
      {
        "id": "condition-2",
        "criterion": "index.html の変更がコミットされている",
        "required": true
      },
      {
        "id": "condition-3",
        "criterion": "説明の URL と git diff の変更内容が、提出された変更に合っている",
        "required": true
      }
    ],
    "escalateWhen": []
  },
  "support": {
    "hintLevels": 0,
    "solutionUnlock": "passed"
  },
  "sources": [
    "SRC-dev-env-local-server-20261107",
    "SRC-dev-env-git-commit-20261107",
    "SRC-dev-env-git-diff-20261107"
  ],
  "estimatedMinutes": 60,
  "protected": [
    "tests/**",
    "server.mjs"
  ],
  "checks": {
    "lint": false,
    "format": false
  },
  "static": {
    "checks": [
      {
        "type": "element-text",
        "path": "index.html",
        "tag": "h1",
        "text": "今週のお知らせ",
        "match": "exact"
      },
      {
        "type": "element-count",
        "path": "index.html",
        "tag": "p",
        "min": 2
      }
    ]
  },
  "git": {
    "checks": [
      {
        "type": "committed",
        "paths": [
          "index.html"
        ]
      },
      {
        "type": "commit-count",
        "min": 2
      }
    ]
  }
}
