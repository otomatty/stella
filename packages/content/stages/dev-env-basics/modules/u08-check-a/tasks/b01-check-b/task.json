      },
      {
        "id": "condition-4",
        "criterion": "説明の作成場所・内容・困ったことと試したことが、提出ファイルと変更に合っている",
        "required": true
      }
    ],
    "escalateWhen": []
  },
  "support": {
    "hintLevels": 0,
