{
  "id": "dev-env-basics/u04-links/r03-broken-link",
  "title": "リンクを押すとページが無いと言われる",
  "kind": "debug",
  "pattern": "relative-link",
  "skills": {
    "uses": [
      "file-save-reopen",
      "html-document"
    ],
    "assesses": [
      "relative-link",
      "preview-changes"
    ]
  },
  "runner": "static-preview",
  "environment": "static-web-01",
  "submit": {
