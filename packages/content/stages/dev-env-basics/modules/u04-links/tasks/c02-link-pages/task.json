{
  "id": "dev-env-basics/u04-links/c02-link-pages",
  "title": "2つのページをリンクでつなぐ",
  "kind": "connection",
  "pattern": "relative-link",
  "skills": {
    "uses": [
      "file-save-reopen",
      "html-document"
    ],
    "assesses": [
      "relative-link",
      "preview-changes"
    ]
  },
  "runner": "static-preview",
  "environment": "static-web-02",
  "submit": {
    "files": [
      "index.html",
      "pages/about.html"
    ],
    "explanation": true,
    "debuggingRecord": false
  },
  "review": {
    "rubric": [
      {
        "id": "condition-1",
        "criterion": "index.html のリンクが pages/about.html を開く",
        "required": true
      },
      {
        "id": "condition-2",
        "criterion": "pages/about.html のリンクが1つ上の index.html を開く",
        "required": true
      },
      {
        "id": "browser-preview",
        "criterion": "提出の説明に、開いたページと、リンクを押して移った先が書かれている",
        "required": true
      }
    ],
    "escalateWhen": []
  },
  "support": {
    "hintLevels": 2,
    "solutionUnlock": "after-hints"
  },
  "sources": [
    "SRC-dev-env-links-20261107",
    "SRC-dev-env-files-20261107"
  ],
  "estimatedMinutes": 20,
  "protected": [
    "tests/**"
  ],
  "checks": {
    "lint": false,
    "format": false
  },
  "static": {
    "checks": [
      {
        "type": "element-count",
        "path": "index.html",
        "tag": "a",
        "min": 1
      },
      {
        "type": "links-resolve",
        "path": "index.html"
      },
      {
        "type": "element-count",
        "path": "pages/about.html",
        "tag": "a",
        "min": 1
      },
      {
        "type": "links-resolve",
        "path": "pages/about.html"
      }
    ]
  }
}
