{
  "schema": 1,
  "brief": {
    "goal": "文字列から整数を取り出し、NaN・有限の数・整数を調べる例を説明できる。",
    "stuck": "number 型なら、どの値も普通の計算に使えると考えてしまう。",
    "points": [
      "Number.parseInt は文字列の先頭から整数を取り出す。",
      "NaN は Number.isNaN で、有限の数は Number.isFinite で調べる。",
      "Number.isInteger は整数かを調べる。"
    ],
    "leaveOut": [
      "すべての文字を数に変える Number との比較",
      "小数の誤差の詳しい仕組み",
      "問題の答えのコード"
    ]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "文字の付いた注文数",
      "code": ["// 注文の入力は \"12個\"", "// 計算には数値が必要"],
      "beats": [
        {
          "say": "注文数が、個という文字付きで届きました。",
          "type": [0]
        },
        {
          "say": "計算に使う数は、どう取り出せるでしょうか。",
          "type": [1]
        }
      ]
    },
    {
      "id": "parse",
      "kind": "code",
      "role": "point",
      "title": "先頭から整数を取り出す",
      "code": [
        "// 入力 input を作り、12個という文字列を入れる",
        "const input = \"12個\";",
        "// 数量 quantity に、先頭の整数を入れる",
        "const quantity = Number.parseInt(input, 10);",
        "// 読めない入力を、別の名前 missing に入れる",
        "const missing = Number.parseInt(\"約3\", 10);"
      ],
      "beats": [
        {
          "say": "Number.parseInt は、先頭から整数を読みます。",
          "speech": "ナンバー・パースイントは、先頭から整数を読みます。",
          "type": [0, 1, 2, 3]
        },
        {
          "say": "二つ目の十は、十進数で読む指定です。",
          "part": {
            "line": 3,
            "text": "10"
          }
        },
        {
          "say": "数字の後の文字で止まり、十二が入ります。",
          "calc": {
            "on": "quantity",
            "expr": "Number.parseInt(\"12個\", 10)",
            "result": "12"
          }
        },
        {
          "say": "先頭に数字がないと、数を取り出せません。",
          "type": [4, 5]
        },
        {
          "say": "NaN は、数にできないことを表す特別な値です。",
          "speech": "ナンは、数にできないことを表す特別な値です。",
          "set": {
            "missing": "NaN"
          }
        }
      ],
      "point": 1,
      "panel": {
        "kind": "values",
        "items": ["quantity", "missing"]
      }
    },
    {
      "id": "nan",
      "kind": "code",
      "role": "point",
      "title": "NaN の調べ方",
      "code": [
        "// 読めない数量 count を作る",
        "const count = Number.parseInt(\"なし\", 10);",
        "// 間違いの例。NaN と等しいかを比べる",
        "const wrong = count === NaN;",
        "// 取り出せなかったかを failed に入れる",
        "const failed = Number.isNaN(count);"
      ],
      "beats": [
        {
          "say": "NaN も、型としては number の仲間です。",
          "speech": "ナンも、型としてはナンバーの仲間です。",
          "type": [0, 1],
          "set": {
            "count": "NaN"
          }
        },
        {
          "say": "NaN は、自分自身とも等しくなりません。",
          "speech": "ナンは、自分自身とも等しくなりません。",
          "type": [2, 3],
          "mark": [
            {
              "line": 3,
              "kind": "cross"
            }
          ]
        },
        {
          "say": "この比較の結果は、いつも false です。",
          "speech": "この比較の結果は、いつもフォルスです。",
          "set": {
            "wrong": "false"
          }
        },
        {
          "say": "Number.isNaN なら、数にできなかったか調べられます。",
          "speech": "ナンバー・イズナンなら、数にできなかったか調べられます。",
          "type": [4, 5]
        },
        {
          "say": "今回は NaN なので、true が入ります。",
          "speech": "今回はナンなので、トゥルーが入ります。",
          "calc": {
            "on": "failed",
            "expr": "Number.isNaN(count)",
            "result": "true"
          }
        }
      ],
      "point": 2,
      "panel": {
        "kind": "values",
        "items": ["count", "wrong", "failed"]
      }
    },
    {
      "id": "finite",
      "kind": "code",
      "role": "point",
      "title": "有限の数かを調べる",
      "code": [
        "// 一個の金額 unitPrice に、1000 を 0 で割った数を入れる",
        "const unitPrice = 1000 / 0;",
        "// 有限の数かを valid に入れる",
        "const valid = Number.isFinite(unitPrice);",
        "// 小数の金額が有限かを normal に入れる",
        "const normal = Number.isFinite(1.5);"
      ],
      "beats": [
        {
          "say": "正の数をゼロで割ると、Infinity になります。",
          "speech": "正の数をゼロで割ると、インフィニティになります。",
          "type": [0, 1],
          "set": {
            "unitPrice": "Infinity"
          }
        },
        {
          "say": "これは無限大を表す、特別な数値です。",
          "part": {
            "line": 1,
            "text": "/ 0"
          }
        },
        {
          "say": "Number.isFinite は、有限の数かを調べます。",
          "speech": "ナンバー・イズファイナイトは、有限の数かを調べます。",
          "type": [2, 3]
        },
        {
          "say": "無限大や NaN なら、false になります。",
          "speech": "無限大やナンなら、フォルスになります。",
          "set": {
            "valid": "false"
          }
        },
        {
          "say": "一点五のような小数も、有限の数です。",
          "type": [4, 5],
          "set": {
            "normal": "true"
          }
        }
      ],
      "point": 2,
      "panel": {
        "kind": "values",
        "items": ["unitPrice", "valid", "normal"]
      }
    },
    {
      "id": "integer",
      "kind": "code",
      "role": "point",
      "title": "整数かを調べる",
      "code": [
        "// 注文数 quantity を作り、2.5 を入れる",
        "const quantity = 2.5;",
        "// 整数かを whole に入れる",
        "const whole = Number.isInteger(quantity);",
        "// 整数でないかを invalid に入れる",
        "const invalid = !whole;"
      ],
      "beats": [
        {
          "say": "Number.isInteger は、整数かを調べます。",
          "speech": "ナンバー・イズインテジャーは、整数かを調べます。",
          "type": [0, 1, 2, 3]
        },
        {
          "say": "二点五は整数でないので、false です。",
          "speech": "二点五は整数でないので、フォルスです。",
          "calc": {
            "on": "whole",
            "expr": "Number.isInteger(2.5)",
            "result": "false"
          }
        },
        {
          "say": "感嘆符を付けると、整数でないかを表せます。",
          "type": [4, 5],
          "calc": {
            "on": "invalid",
            "expr": "!false",
            "result": "true"
          }
        }
      ],
      "point": 3,
      "panel": {
        "kind": "values",
        "items": ["whole", "invalid"]
      }
    },
    {
