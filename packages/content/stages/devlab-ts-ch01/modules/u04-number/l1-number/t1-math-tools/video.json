{
  "schema": 1,
  "brief": {
    "goal": "数の型注釈を読み、距離・累乗・平方根・範囲の計算を説明できる。",
    "stuck": "同じ number 型でも、求めたい数によって使う道具が違う。",
    "points": [
      "数の入口と出口に型を書き、Math.abs でゼロからの距離を求める。",
      "累乗は同じ数の掛け算で、平方根はその逆を考える。",
      "Math.min と Math.max で上限と下限を守る。"
    ],
    "leaveOut": [
      "エラーを投げる書き方",
      "文字列から数を取り出す書き方",
      "問題の答えのコード",
      "浮動小数点の内部表現"
    ]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "在庫のずれはどれくらい？",
      "code": [
        "// 予定していた在庫数",
        "const planned = 5;",
        "// 実際にあった在庫数",
        "const actual = 2;"
      ],
      "beats": [
        {
          "say": "在庫が予定より少ない場面です。",
          "type": [0, 1]
        },
        {
          "say": "予定と実際の差は、マイナスになります。",
          "type": [2, 3]
        },
        {
          "say": "ずれの大きさだけなら、どんな数でしょうか。",
          "focus": [1, 3]
        }
      ]
    },
    {
      "id": "distance",
      "kind": "code",
      "role": "point",
      "title": "型を書き、ゼロからの距離を求める",
      "code": [
        "// 送料を足す関数を作り、数値を受け取り返す",
        "export function addShipping(price: number): number {",
        "  // 送料 500 を足した数を返す",
        "  return price + 500;",
        "  // 関数の中身はここまで",
        "}",
        "// ずれ gap を作り、-3 の絶対値を入れる",
        "const gap = Math.abs(-3);"
      ],
      "beats": [
        {
          "say": "引数と戻り値の型は、自分で書きます。",
          "type": [0, 1]
        },
        {
          "say": "かっこの中は、受け取る数値の型です。",
          "part": {
            "line": 1,
            "text": "price: number"
          }
        },
        {
          "say": "かっこの後ろは、返す数値の型です。",
          "type": [2, 3, 4, 5],
          "part": {
            "line": 1,
            "text": "): number"
          }
        },
        {
          "say": "絶対値は、ゼロからの距離を表す数です。",
          "type": [6, 7],
          "plot": {
            "at": -3,
            "label": "-3"
          }
        },
        {
          "say": "Math.abs なら、マイナス三の距離は三です。",
          "speech": "マス・アブスなら、マイナス三の距離は三です。",
          "range": [-3, 0],
          "set": {
            "gap": "3"
          }
        },
        {
          "say": "三もゼロから同じ距離なので、結果は三です。",
          "plot": {
            "at": 3,
            "label": "3"
          },
          "range": [0, 3]
        }
      ],
      "point": 1,
      "panel": {
        "kind": "numberLine",
        "from": -3,
        "to": 3,
        "items": ["gap"]
      }
    },
    {
      "id": "powers",
      "kind": "code",
      "role": "point",
      "title": "掛け算と、その逆の計算",
      "code": [
        "// 容量 capacity を作り、2 の 10 乗を入れる",
        "const capacity = 2 ** 10;",
        "// 正方形の棚の一辺 side に、49 の平方根を入れる",
        "const side = Math.sqrt(49);",
        "// 棚の横 6 と縦 8 から、対角線 diagonal を求める",
        "const diagonal = Math.hypot(6, 8);"
      ],
      "beats": [
        {
          "say": "累乗は、同じ数を繰り返し掛ける計算です。",
          "type": [0, 1]
        },
        {
          "say": "星二つで二の十乗を書き、千二十四になります。",
          "part": {
            "line": 1,
            "text": "**"
          },
          "calc": {
            "on": "capacity",
            "expr": "2 ** 10",
            "result": "1024"
          }
        },
        {
          "say": "平方根は、二乗すると元の数になる数です。",
          "type": [2, 3]
        },
        {
          "say": "Math.sqrt は、四十九から七を求めます。",
          "speech": "マス・スクエアルートは、四十九から七を求めます。",
          "calc": {
            "on": "side",
            "expr": "Math.sqrt(49)",
            "result": "7"
          }
        },
        {
          "say": "Math.hypot は、縦と横から斜めを求めます。",
          "speech": "マス・ハイポットは、縦と横から斜めを求めます。",
          "type": [4, 5]
        },
        {
          "say": "六と八を二乗して足すと百で、平方根は十です。",
          "calc": {
            "on": "diagonal",
            "expr": "Math.hypot(6, 8)",
            "result": "10"
          }
        }
      ],
      "point": 2,
      "panel": {
        "kind": "values",
        "items": ["capacity", "side", "diagonal"]
      }
    },
    {
      "id": "limits",
      "kind": "code",
      "role": "point",
      "title": "下限と上限を守る",
      "code": [
        "// 仮の予約数 requested を作り、5 を入れる",
        "const requested = 5;",
        "// 最低 1 席になるよう、lower に大きい方を入れる",
        "const lower = Math.max(requested, 1);",
        "// 最大 4 席になるよう、seats に小さい方を入れる",
        "const seats = Math.min(lower, 4);",
        "// 間違いの例。最大値を選ぶと上限を超える",
        "const wrongSeats = Math.max(lower, 4);"
      ],
      "beats": [
        {
          "say": "予約の席数を、一から四の範囲に収めます。",
          "type": [0, 1],
          "plot": {
            "at": 5,
            "label": "希望 5"
          }
        },
        {
          "say": "Math.max は大きい方を選び、下限を守ります。",
          "speech": "マス・マックスは大きい方を選び、下限を守ります。",
          "type": [2, 3],
          "set": {
            "lower": "5"
          }
        },
        {
          "say": "Math.min は小さい方を選び、上限を守ります。",
          "speech": "マス・ミンは小さい方を選び、上限を守ります。",
          "type": [4, 5],
          "range": [1, 4]
        },
        {
          "say": "希望の五席は、上限の四席に収まります。",
          "snap": {
            "to": 4,
            "label": "上限"
          },
          "set": {
            "seats": "4"
          }
        },
        {
          "say": "上限にも大きい方を選ぶと、五のままです。",
          "type": [6, 7],
          "mark": [
            {
              "line": 7,
              "kind": "cross"
            }
          ]
        }
      ],
      "point": 3,
      "panel": {
        "kind": "numberLine",
        "from": 0,
        "to": 5,
        "items": ["lower", "seats"]
      }
    },
    {
      "id": "recap",
      "kind": "code",
      "role": "recap",
      "title": "問7 の入口と出口",
      "code": [
        "// 数値を受け取り、数値を返す関数を作る",
        "export function cube(n: number): number {",
        "  // ここに書く",
        "}"
      ],
      "beats": [
        {
          "say": "問七では、受け取った数の三乗を返します。",
          "type": [0, 1, 2, 3]
        },
        {
          "say": "三を受け取ると、二十七を返します。",
          "row": [0]
        },
        {
          "say": "マイナス二なら、マイナス八を返します。",
          "row": [1]
        },
        {
          "say": "型注釈と累乗を使って、書いてみましょう。",
          "focus": [1]
        }
      ],
      "panel": {
        "kind": "calls",
        "rows": [
          {
            "call": "cube(3)",
            "result": "27"
          },
          {
            "call": "cube(-2)",
            "result": "-8"
          }
        ]
      }
    }
  ]
}
