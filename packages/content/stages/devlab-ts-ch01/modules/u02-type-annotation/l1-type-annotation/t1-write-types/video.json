      "code": [
        "// 関数 isFreeShipping を作り、合計を受け取る",
        "function isFreeShipping(total: number): boolean {",
        "  // 5000以上かどうかを返す",
        "  return total >= 5000;",
        "  // 関数はここまで",
        "}"
      ],
      "beats": [
        {
          "say": "はいといいえを返すときは、boolean と書きます。",
          "speech": "はいといいえを返すときは、ブーリアンと書きます。",
          "type": [0, 1]
        },
        {
          "say": "比べた結果は、true か false になります。",
          "speech": "比べた結果は、トゥルーかフォルスになります。",
          "type": [2, 3, 4, 5]
        },
        {
          "say": "6000 円なら、送料が無料という結果です。",
          "set": {
            "total": "6000",
            "結果": "true"
          }
        },
        {
          "say": "3000 円なら、無料にはならないという結果です。",
          "set": {
            "total": "3000",
            "結果": "false"
          }
        }
      ],
      "point": 3,
      "panel": {
        "kind": "values",
        "items": ["total", "結果"]
      }
    },
    {
