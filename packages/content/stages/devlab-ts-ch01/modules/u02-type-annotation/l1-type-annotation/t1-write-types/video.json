{
  "schema": 1,
  "brief": {
    "goal": "関数の引数と戻り値に型注釈を書き、渡す値の型と順番を確かめられる。",
    "stuck": "完成していた関数の形を自分で書くとき、型を書く場所が分からない。",
    "points": [
      "引数の型は名前の後ろ、戻り値の型はかっこの後ろに書く。",
      "引数は数と順番をそろえ、違う型は実行前に見つける。",
      "true か false を返す関数の戻り値は boolean と書く。"
    ],
    "leaveOut": ["型推論の詳しい説明", "文字列の道具", "問1から応用までの答えのコード"]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "配送のラベルを作る",
      "code": ["// 宛先は名古屋", "// 届くまで3日", "// 文字と数をどう受け取る？"],
      "beats": [
        {
          "say": "配送のラベルに、宛先と日数を載せたいです。",
          "type": [0]
        },
        {
          "say": "宛先は文字で、日数は数です。",
          "type": [1]
        },
        {
          "say": "受け取る値の種類を、どう決めるのでしょうか。",
          "type": [2]
        }
      ]
    },
    {
      "id": "annotation",
      "kind": "code",
      "role": "point",
      "title": "型を書く場所",
      "code": [
        "// 関数 shippingLabel を作り、宛先と日数を受け取る",
        "function shippingLabel(city: string, days: number): string {",
        "  // 宛先と日数を埋め込んだ文字列を返す",
        "  return `${city}まで${days}日`;",
        "  // 関数はここまで",
        "}"
      ],
      "beats": [
        {
          "say": "型は値の種類で、型注釈はその種類を書く印です。",
          "type": [0, 1]
        },
        {
          "say": "引数は、名前の後ろにコロンと型を書きます。",
          "part": {
            "line": 1,
            "text": "city: string"
          }
        },
        {
          "say": "文字列には、string と書きます。",
          "speech": "文字列には、ストリングと書きます。",
          "part": {
            "line": 1,
            "text": "string"
          }
        },
        {
          "say": "日数は数なので、number と書きます。",
          "speech": "日数は数なので、ナンバーと書きます。",
          "part": {
            "line": 1,
            "text": "days: number"
          }
        },
        {
          "say": "戻り値の型は、閉じかっこの後ろに書きます。",
          "part": {
            "line": 1,
            "text": "): string"
          }
        },
        {
          "say": "ここでは、宛先と日数をまとめた文字を返します。",
          "type": [2, 3, 4, 5]
        }
      ],
      "point": 1
    },
    {
      "id": "call",
      "kind": "code",
      "role": "point",
      "title": "並んだ順に受け取る",
      "code": [
        "// 宛先と日数をこの順で渡し、label を作る",
        "const label = shippingLabel(\"名古屋\", 3);",
        "// 型をそろえず、順番を逆にした呼び出し",
        "shippingLabel(3, \"名古屋\");"
      ],
      "beats": [
        {
          "say": "引数は、渡した順番に受け取ります。",
          "type": [0, 1]
        },
        {
          "say": "最初の文字が宛先、次の数が日数に入ります。",
          "set": {
            "city": "\"名古屋\"",
            "days": "3"
          }
        },
        {
          "say": "返された文字列を、名前に入れて使えます。",
          "calc": {
            "on": "label",
            "expr": "宛先と日数を埋め込む",
            "result": "\"名古屋まで3日\""
          }
        },
        {
          "say": "順番を逆にすると、実行前に型のエラーです。",
          "type": [2, 3],
          "mark": [
            {
              "line": 3,
              "kind": "cross"
            }
          ]
