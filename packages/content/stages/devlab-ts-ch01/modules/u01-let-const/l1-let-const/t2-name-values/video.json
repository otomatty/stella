{
  "schema": 1,
  "brief": {
    "goal": "const で値に名前を付け、計算した結果を名前に入れるコードを読める。",
    "stuck": "変数や = の意味が分からず、問題の関数の中に何を書けばよいか想像できない。",
    "points": [
      "const は、値に名前を付ける書き方。",
      "= の右の計算が先に行われ、結果が左の名前に入る。掛け算は * で書く。",
      "Math.floor で、小数点以下を切り捨てる。"
    ],
    "leaveOut": [
      "let と入れ直しの書き方",
      "型注釈の詳しい説明",
      "Math.ceil や四捨五入",
      "問1 の答えのコード"
    ]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "本と送料でいくら？",
      "code": [
        "// 本の代金と送料の合計を返す関数を作る",
        "export function bookTotal(): number {",
        "  // 1200 に 500 を足した数を返す",
        "  return 1200 + 500;",
        "  // 関数の中身はここまで",
        "}"
      ],
      "beats": [
        {
          "say": "本を注文します。",
          "type": [0, 1, 2, 3, 4, 5]
        },
        {
          "say": "送料を足して、合計を返します。",
          "part": {
            "line": 3,
            "text": "1200 + 500"
          }
        },
        {
          "say": "どちらが送料か、ひと目で分かるでしょうか。",
          "focus": [3]
        }
      ]
    },
    {
      "id": "name",
      "kind": "code",
      "role": "point",
      "point": 1,
      "title": "const は値に名前を付ける",
      "code": [
        "// 価格 price を作り、1200 を入れる",
        "const price = 1200;",
        "// 送料 shipping を作り、500 を入れる",
        "const shipping = 500;"
      ],
      "panel": {
        "kind": "values",
        "items": ["price", "shipping"]
      },
      "beats": [
        {
          "say": "値に名前を付けるときは、const を使います。",
          "type": [0, 1]
        },
        {
          "say": "price という名前に、1200 が入ります。",
          "speech": "プライスという名前に、千二百が入ります。",
          "focus": [1],
          "set": {
            "price": "1200"
          }
        },
        {
          "say": "名前は、中身が分かるように付けます。",
          "part": {
            "line": 1,
            "text": "price"
          }
        },
        {
          "say": "送料も同じ形で、500 を入れます。",
          "type": [2, 3],
          "set": {
            "shipping": "500"
          }
        }
      ]
    },
    {
      "id": "calc",
      "kind": "code",
      "role": "point",
      "point": 2,
      "title": "計算した結果が入る",
      "code": [
        "const price = 1200;",
        "const shipping = 500;",
        "// 合計 total を作り、price と shipping を足した数を入れる",
        "const total = price + shipping;",
        "// 3 冊分の金額 cost を作り、price × 3 を入れる",
        "const cost = price * 3;"
      ],
      "panel": {
        "kind": "values",
        "items": ["price", "shipping", "total", "cost"]
      },
      "beats": [
        {
          "say": "さきほどの price と shipping を使います。",
          "speech": "さきほどのプライスとシッピングを使います。",
          "type": [0, 1],
          "set": {
            "price": "1200",
            "shipping": "500"
          }
        },
        {
          "say": "合計は、2 つを足した数です。",
          "type": [2, 3]
        },
        {
          "say": "右側が先に計算され、1700 が total に入ります。",
          "speech": "右側が先に計算され、千七百がトータルに入ります。",
          "focus": [3],
          "calc": {
            "on": "total",
            "expr": "1200 + 500",
            "result": "1700"
          }
        },
        {
          "say": "掛け算は、かける記号ではなく、アスタリスクで書きます。",
          "type": [4, 5],
          "part": {
            "line": 5,
            "text": "*"
          }
        },
        {
          "say": "1200 の 3 倍で、3600 が入ります。",
          "focus": [5],
          "calc": {
            "on": "cost",
            "expr": "1200 * 3",
            "result": "3600"
          }
        }
      ]
    },
    {
      "id": "mistake",
      "kind": "code",
      "role": "point",
      "point": 2,
      "title": "= は「右を左に入れる」",
      "code": [
        "// 在庫 stock を作り、10 を入れる",
        "const stock = 10;",
        "// stock に 5 を足した数を、stock に入れ直す",
        "stock = stock + 5;"
      ],
      "panel": {
        "kind": "values",
        "items": ["stock"]
      },
      "beats": [
        {
          "say": "イコールは、等しいという意味ではありません。",
          "type": [0, 1],
          "set": {
            "stock": "10"
          }
        },
        {
          "say": "右の値を、左の名前に入れる印です。",
          "part": {
            "line": 1,
            "text": "="
          }
        },
        {
          "say": "const で作った名前には、あとから入れ直せません。",
          "type": [2, 3],
          "mark": [
            {
              "line": 3,
              "kind": "cross"
            }
          ]
        },
        {
          "say": "入れ直す書き方は、このあと学びます。",
          "focus": [3]
        }
      ]
    },
    {
      "id": "floor",
      "kind": "code",
      "role": "point",
      "point": 3,
      "title": "Math.floorで切り捨てる",
      "code": [
        "// ポイント points を作り、1980 ÷ 100 を切り捨てた数を入れる",
        "const points = Math.floor(1980 / 100);"
      ],
      "panel": {
        "kind": "numberLine",
        "from": 18,
        "to": 21,
        "items": ["points"]
      },
      "beats": [
        {
          "say": "小数点以下を捨てるときは、Math.floor を使います。",
          "speech": "小数点以下を捨てるときは、マスドットフロアを使います。",
          "type": [0, 1]
        },
        {
          "say": "まず、1980 を 100 で割ると、19.8 です。",
          "focus": [1],
          "plot": { "at": 19.8, "label": "19.8" }
        },
        {
          "say": "19.8 は、19 と 20 の間にあります。",
          "range": [19, 20]
        },
        {
          "say": "Math.floor は、小さいほうの 19 に切り捨てます。",
          "speech": "マスドットフロアは、小さいほうの十九に切り捨てます。",
          "snap": { "to": 19, "label": "切り捨て" }
        },
        {
          "say": "四捨五入ではないので、20 にはなりません。",
          "tick": [{ "at": 20, "kind": "cross" }]
        },
        {
          "say": "points には、19 が入ります。",
          "speech": "ポインツには、十九が入ります。",
          "set": { "points": "19" }
        }
      ]
    },
    {
      "id": "recap",
      "kind": "code",
      "role": "recap",
      "title": "問1 で使う",
      "code": ["export function addTax(price: number): number {", "  // ここに書く", "}"],
      "panel": {
        "kind": "calls",
        "rows": [
          {
            "call": "addTax(1000)",
            "result": "1100",
            "note": "税額は 100 円"
          },
          {
            "call": "addTax(980)",
            "result": "1078",
            "note": "税額は 98 円"
          },
          {
            "call": "addTax(5)",
            "result": "5",
            "note": "0.5 円を切り捨てて 0 円"
          }
        ]
      },
      "beats": [
        {
          "say": "問1 では、税込の金額を返す関数を書きます。",
          "type": [0, 1, 2]
        },
        {
          "say": "1000 円なら、1100 円を返します。",
          "row": [0]
        },
        {
          "say": "980 円なら、税は 98 円で、1078 円です。",
          "row": [1]
        },
        {
          "say": "5 円なら、税の 0.5 円を切り捨てて、5 円のままです。",
          "row": [2]
        },
        {
          "say": "const と Math.floor を使って、書いてみましょう。",
          "speech": "コンストとマスドットフロアを使って、書いてみましょう。",
          "focus": [1]
        }
      ]
    }
  ]
}
