{
  "schema": 1,
  "brief": {
    "goal": "余りを求め、テンプレートリテラルへ数値を埋め込む例を読める。",
    "stuck": "% を割合と読み、文字と数値をどう組み合わせるか分からない。",
    "points": [
      "% は、割り算の余りを求める。",
      "テンプレートリテラルはバッククォートで囲み、文字列の型は string と書く。",
      "この課題では文字列を + でつなぐと lint のエラーになる。"
    ],
    "leaveOut": ["負の数の余り", "文字列の詳しい操作", "繰り返しと条件分岐", "問3の答えのコード"]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "注文の残りを知らせたい",
      "code": ["// 卵 14 個を、4 個ずつパックに詰める", "// 余った数を、注文の案内文にできる？"],
      "beats": [
        {
          "say": "14 個の卵を、4 個ずつパックに詰めます。",
          "type": [0]
        },
        {
          "say": "余った数を、案内の文にできるでしょうか。",
          "type": [1]
        }
      ]
    },
    {
      "id": "remainder",
      "kind": "code",
      "role": "point",
      "title": "割った余りを求める",
      "code": [
        "// 卵の数 eggs を作り、14 を入れる",
        "const eggs = 14;",
        "// 余り left を作り、eggs を 4 で割った余りを入れる",
        "const left = eggs % 4;"
      ],
      "beats": [
        {
          "say": "余りは、同じ数ずつ分けて残った数です。",
          "type": [0, 1],
          "set": {
            "eggs": "14"
          }
        },
        {
          "say": "パーセント記号は、コードでは余りを求めます。",
          "type": [2, 3]
        },
        {
          "say": "4 個ずつ 3 組にすると、2 個残ります。",
          "calc": {
            "on": "left",
            "expr": "14 % 4",
            "result": "2"
          },
          "plot": {
            "at": 2,
            "label": "余り 2"
          }
        },
        {
          "say": "この数の余りは、0 から割る数の手前までです。",
          "range": [0, 4],
          "tick": [
            {
              "at": 4,
              "kind": "cross"
            }
          ]
        },
        {
          "say": "割り切れるときは、余りが 0 になります。",
          "calc": {
            "on": "left",
            "expr": "12 % 4",
            "result": "0"
          },
          "plot": {
            "at": 0,
            "label": "余り 0"
          }
        }
      ],
      "panel": {
        "kind": "numberLine",
        "from": 0,
        "to": 4,
        "items": ["eggs", "left"]
      },
      "point": 1
    },
    {
      "id": "template",
      "kind": "code",
      "role": "point",
      "title": "文に値を埋め込む",
      "code": [
        "// 商品名 item を作り、ノートを入れる",
        "const item = \"ノート\";",
        "// 冊数 count を作り、3 を入れる",
        "const count = 3;",
        "// 案内文 message を作り、商品名と冊数を埋め込む",
        "const message = `${item}を${count}冊注文しました`;"
      ],
      "beats": [
        {
          "say": "文字列は文字を並べた値で、型は string です。",
          "type": [0, 1],
          "set": {
            "item": "ノート"
          },
          "speech": "文字列は文字を並べた値で、型はストリングです。"
        },
        {
          "say": "注文した冊数には、3 を入れます。",
          "type": [2, 3],
          "set": {
            "count": "3"
          }
        },
        {
          "say": "値を文に埋め込む形を、テンプレートリテラルと呼びます。",
          "type": [4, 5]
        },
        {
          "say": "ドル記号と波かっこの中が、値に置き換わります。",
          "part": {
            "line": 5,
            "text": "${item}"
          }
        },
        {
          "say": "数値の 3 も、文字として文に入ります。",
          "part": {
            "line": 5,
            "text": "${count}"
          },
          "calc": {
            "on": "message",
            "expr": "商品名と冊数を埋め込む",
            "result": "ノートを3冊注文しました"
          }
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["item", "count", "message"]
      },
      "point": 2
    },
    {
      "id": "keyboard",
      "kind": "code",
      "role": "point",
      "title": "バッククォートで囲む",
      "code": [
        "// 案内文を、バッククォートで囲んで作る",
        "const message = `${item}を${count}冊注文しました`;",
        "// 日本語配列: Shift + @",
        "// 英語配列: 1 の左のキー"
      ],
      "beats": [
        {
          "say": "文の両端は、バッククォートという記号で囲みます。",
          "type": [0, 1],
          "part": {
            "line": 1,
            "text": "`"
          }
        },
        {
          "say": "日本語配列では、シフトとアットマークを押します。",
          "type": [2]
        },
        {
          "say": "英語配列では、数字の 1 の左のキーです。",
          "type": [3]
        }
      ],
      "point": 2
    },
    {
      "id": "mistake",
      "kind": "code",
      "role": "point",
      "title": "引用符と足し算に注意",
      "code": [
        "// 引用符で囲むと、値を埋め込めない間違い",
        "const message = \"${item}を注文しました\";",
        "// 文字列を + でつなぐ、課題の決まりに反する例",
        "const notice = item + \"を注文しました\";"
      ],
      "beats": [
        {
          "say": "普通の引用符では、波かっこの部分もそのままの文字です。",
          "type": [0, 1],
          "mark": [
            {
              "line": 1,
              "kind": "cross"
            }
          ]
        },
        {
          "say": "この課題は、文字を足し算でつなぐとエラーです。",
          "type": [2, 3],
          "mark": [
            {
              "line": 3,
              "kind": "cross"
            }
          ]
        },
        {
          "say": "lint は、コードが決まりに合うか確かめる検査です。",
          "part": {
            "line": 3,
            "text": "+"
          },
          "speech": "リントは、コードが決まりに合うか確かめる検査です。"
        }
      ],
      "point": 3
    },
    {
      "id": "recap",
      "kind": "code",
      "role": "recap",
      "title": "問3の形と値",
      "code": [
        "// 問3は分を受け取り、時間と分の文字列を返す",
        "export function minutesToText(minutes: number): string {",
        "  // ここに書く",
        "}"
      ],
      "beats": [
        {
          "say": "問3 は、時間と残りの分を文字列にします。",
          "type": [0, 1, 2, 3]
        },
        {
          "say": "戻り値の string は、文字列を表す型です。",
          "part": {
            "line": 1,
            "text": "): string"
          },
          "speech": "戻り値のストリングは、文字列を表す型です。"
        },
        {
          "say": "125 分は、2 時間 5 分という文にします。",
          "row": [0]
        },
        {
          "say": "60 分なら、残りの分は 0 と書きます。",
          "row": [1]
        },
        {
          "say": "45 分なら、時間の部分は 0 と書きます。",
          "row": [2]
        },
        {
          "say": "余りとテンプレートリテラルで、書いてみましょう。",
          "focus": [2]
        }
      ],
      "panel": {
        "kind": "calls",
        "rows": [
          {
            "call": "minutesToText(125)",
            "result": "\"2時間5分\""
          },
          {
            "call": "minutesToText(60)",
            "result": "\"1時間0分\""
          },
          {
            "call": "minutesToText(45)",
            "result": "\"0時間45分\""
          }
        ]
      }
    }
  ]
}
