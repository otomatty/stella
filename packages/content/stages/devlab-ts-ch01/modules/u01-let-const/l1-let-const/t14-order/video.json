      "title": "関数の中で順番を決める",
      "code": [
        "// 品物の値段と送料を受け取り、2 人で割った 1 人分を返す関数",
        "function giftShare(item: number, shipping: number): number {",
        "  // 合計 total を作り、値段と送料を足す",
        "  const total = item + shipping;",
        "  // 合計を 2 で割って返す",
        "  return total / 2;",
        "}",
        "// 800 円の品物と 400 円の送料で、関数を呼ぶ",
        "giftShare(800, 400);"
      ],
