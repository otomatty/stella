    {
      "id": "apply",
      "kind": "code",
      "role": "apply",
      "title": "値の動きをたどる",
      "code": [
        "// 125秒に含まれる分を求める",
        "const minutes = Math.floor(125 / 60);",
        "// 分に含まれない残りの秒を求める",
        "const seconds = 125 % 60;",
        "// 分の前を0で埋めて2桁にする",
        "const mm = String(minutes).padStart(2, \"0\");",
        "// 秒の前を0で埋めて2桁にする",
        "const ss = String(seconds).padStart(2, \"0\");",
        "// 分と秒をコロンでつなぐ",
        "const label = `${mm}:${ss}`;"
      ],
      "show": true,
      "panel": {
        "kind": "figure",
        "board": "example"
      },
      "beats": [
        {
          "say": "125 秒を分にすると、整数で 2 分です。",
          "part": {
            "line": 1,
            "text": "Math.floor"
          },
          "figure": {
            "pulse": ["card0"],
            "tag": {
              "card0": "2分"
            }
          },
          "speech": "百二十五 秒を分にすると、整数で 二 分です。"
        },
        {
          "say": "余りは 5 秒になります。",
          "part": {
            "line": 3,
            "text": "% 60"
          },
          "figure": {
            "pulse": ["card1"],
            "tag": {
              "card1": "5秒"
            }
          },
          "speech": "余りは 五 秒になります。"
