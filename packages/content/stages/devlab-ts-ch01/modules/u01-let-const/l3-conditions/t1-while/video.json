      "title": "引数を let に写す",
      "code": [
        "// 関数 ship を作り、在庫 quantity を受け取る",
        "function ship(quantity: number): number {",
        "  // quantity を直接減らすと検査でエラー",
        "  quantity--;",
        "  // 残り rest を入れ直せる変数として作り、quantity を写す",
        "  let rest = quantity;",
        "  // rest を 1 減らす",
        "  rest--;",
        "  // rest を返す",
        "  return rest;",
        "}"
      ],
      "beats": [
        {
          "say": "受け取った引数を、直接減らしてしまいました。",
          "type": [0, 1, 2, 3],
          "set": {
            "quantity": "3"
