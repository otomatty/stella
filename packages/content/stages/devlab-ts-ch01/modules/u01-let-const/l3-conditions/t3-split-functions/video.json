{
  "schema": 1,
  "brief": {
    "goal": "小さな関数を作って呼び、前の計算結果を次に使う順番を説明できる。",
    "stuck": "関数を作るだけで実行したと思い、値を更新する順番も混同する。",
    "points": [
      "アロー関数を const で作り、名前で呼ぶ。",
      "文字列の padStart は足りない長さを先頭で埋める。",
      "引き算も含め、前の結果に名前を付けて次の計算に使う。"
    ],
    "leaveOut": [
      "while と四捨五入は別の動画で扱う",
      "関数の型の詳しい説明",
      "問19・問20・応用の答えのコード"
    ]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "注文番号をそろえたい",
      "code": ["// 整形する注文番号", "const n = 42;"],
      "beats": [
        {
          "say": "注文番号を、五文字にそろえて表示します。",
          "type": [0, 1]
        },
        {
          "say": "足りない桁は、先頭にゼロを足します。",
          "part": { "line": 1, "text": "42" }
        },
        {
          "say": "同じ整形を、何度も書くのでしょうか。",
          "focus": [1]
        }
      ]
    },
    {
      "id": "arrow",
      "kind": "code",
      "role": "point",
      "title": "小さな関数に名前を付ける",
      "code": [
        "// 関数 toYen を作る。price を受け取り、円を付けて返す",
        "const toYen = (price: number) => `${price}円`;",
        "// 表示 label を作り、toYen に 500 を渡した結果を入れる",
        "const label = toYen(500);"
      ],
      "beats": [
        {
          "say": "アロー関数は、関数を短く作る書き方です。",
          "type": [0, 1]
        },
        {
          "say": "矢印の左で引数を受け取り、右の値を返します。",
          "part": {
            "line": 1,
            "text": "=>"
          }
        },
        {
          "say": "式が一つなら、波かっこと return を省けます。",
          "speech": "式が一つなら、波かっことリターンを省けます。",
          "part": {
            "line": 1,
            "text": "`${price}円`"
          }
        },
        {
          "say": "作った関数は、名前の後ろにかっこを付けて呼びます。",
          "type": [2, 3]
        },
        {
          "say": "五百を渡すと、円を付けた文字列が戻ります。",
          "calc": {
            "on": "label",
            "expr": "toYen(500)",
            "result": "\"500円\""
          }
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["label"]
      },
      "point": 1
    },
    {
      "id": "pad",
      "kind": "code",
      "role": "point",
      "title": "先頭を埋める関数",
      "code": [
        "// 関数 orderCode を作る。n を文字列にし、前を 0 で埋める",
        "const orderCode = (n: number) => String(n).padStart(5, \"0\");",
        "// 注文番号 label を作り、orderCode に 42 を渡す",
        "const label = orderCode(42);"
      ],
      "beats": [
        {
          "say": "padStart は、先頭を埋めるメソッドです。",
          "speech": "パッドスタートは、先頭を埋めるメソッドです。",
          "type": [0, 1]
        },
        {
          "say": "数値は、先に String で文字列に変えます。",
          "speech": "数値は、先にストリングで文字列に変えます。",
          "part": {
            "line": 1,
            "text": "String(n)"
          }
        },
        {
          "say": "五文字に足りない分を、ゼロで埋めます。",
          "part": {
            "line": 1,
            "text": ".padStart(5, \"0\")"
          }
        },
        {
          "say": "四十二を渡すと、先頭にゼロが三つ付きます。",
          "type": [2, 3],
          "calc": {
            "on": "label",
            "expr": "orderCode(42)",
            "result": "\"00042\""
          }
        },
        {
          "say": "すでに長さが足りていれば、そのまま返します。",
          "set": {
            "label": "\"12345\""
          }
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["label"]
      },
      "point": 2
    },
    {
      "id": "mistake",
      "kind": "code",
      "role": "point",
