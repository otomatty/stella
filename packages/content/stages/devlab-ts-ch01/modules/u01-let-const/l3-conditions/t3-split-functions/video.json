        {
          "say": "String で文字列にしてから、整形しましょう。",
          "speech": "ストリングで文字列にしてから、整形しましょう。",
          "mark": [
            {
              "line": 1,
              "kind": "cross"
            }
          ]
        }
      ],
      "point": 2
