    {
      "id": "sequence",
      "kind": "code",
      "role": "point",
      "title": "前の結果を次に使う",
      "code": [
        "// 入金後の残高 credited を作り、3000 と 500 を足す",
        "const credited = 3000 + 500;",
        "// 残高 balance を作り、credited から 1200 を引く",
        "const balance = credited - 1200;",
        "// 表示 label を作り、toYen に balance を渡す",
        "const label = toYen(balance);"
      ],
      "beats": [
        {
          "say": "計算を組み立てるときは、順番を決めます。",
          "type": [0, 1],
          "calc": {
            "on": "credited",
            "expr": "3000 + 500",
            "result": "3500"
          }
        },
        {
          "say": "引き算は、ハイフンの記号で書きます。",
          "type": [2, 3],
          "part": {
            "line": 3,
            "text": "-"
          }
        },
        {
          "say": "前の計算結果から、支払う金額を引きます。",
          "calc": {
            "on": "balance",
            "expr": "3500 - 1200",
            "result": "2300"
          }
        },
        {
          "say": "その結果を、先ほど作った関数に渡せます。",
          "type": [4, 5],
          "calc": {
            "on": "label",
            "expr": "toYen(2300)",
            "result": "\"2300円\""
          }
        },
        {
          "say": "二つの値を更新するときも、古い値を先に控えます。",
          "focus": [1, 3]
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["credited", "balance", "label"]
      },
      "point": 3
