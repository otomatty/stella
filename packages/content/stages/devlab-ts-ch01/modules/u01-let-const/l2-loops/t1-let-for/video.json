      "beats": [
        {
          "say": "毎月の積立額を、同じ名前で増やせるでしょうか。",
          "type": [0, 1, 2, 3]
        }
      ]
    },
    {
      "id": "let",
      "kind": "code",
      "role": "point",
      "title": "入れ直す変数だけ let",
      "code": [
        "// 在庫 stock を作り、10 を入れる",
        "const stock = 10;",
        "// stock に 5 を足した数を入れ直す",
        "stock = stock + 5;",
        "// 在庫 stock を入れ直せる変数として作り、10 を入れる",
        "let stock = 10;",
        "// stock に 5 を足した数を入れ直す",
        "stock = stock + 5;"
      ],
      "beats": [
        {
          "say": "const で作ると、あとから入れ直せません。",
          "type": [0, 1],
          "set": {
            "stock": "10"
          }
        },
        {
          "say": "この入れ直しは、エラーになります。",
          "type": [2, 3],
          "mark": [
            {
              "line": 3,
              "kind": "cross"
            }
          ]
        },
        {
          "say": "入れ直す変数だけ、let で作ります。",
          "speech": "入れ直す変数だけ、レットで作ります。",
          "clear": [0, 1, 2, 3],
          "type": [4, 5]
        },
        {
          "say": "let なら、右を計算して十五を入れ直せます。",
          "speech": "レットなら、右を計算して十五を入れ直せます。",
          "type": [6, 7],
          "calc": {
            "on": "stock",
            "expr": "10 + 5",
            "result": "15"
          }
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["stock"]
      },
      "point": 1
    },
    {
      "id": "loop",
      "kind": "code",
      "role": "point",
      "title": "for の順番を追う",
      "code": [
        "// 積立額 saving を入れ直せる変数として作り、0 を入れる",
        "let saving = 0;",
        "// i を 1 から 3 まで 1 ずつ増やしながらくり返す",
        "for (let i = 1; i <= 3; i++) {",
        "  // saving に 5000 を足す",
        "  saving += 5000;",
        "  // くり返す中身はここまで",
        "}"
      ],
      "beats": [
        {
          "say": "for 文は、同じ処理をくり返す書き方です。",
          "speech": "フォー文は、同じ処理をくり返す書き方です。",
          "type": [0, 1],
          "set": {
            "saving": "0"
          }
