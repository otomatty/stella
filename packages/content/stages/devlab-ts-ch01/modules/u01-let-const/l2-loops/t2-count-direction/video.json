{
  "schema": 1,
  "brief": {
    "goal": "for の開始値と条件、更新を変え、実行する回数を説明できる。",
    "stuck": "数を減らすときも増やす条件を書いたり、ゼロから数えて一回多く実行したりする。",
    "points": [
      ">= と -- で大きい数から一まで数える。",
      "ゼロから n 未満まで数えると n 回になる。",
      "中身の前に条件を確かめるので、ゼロ回なら最初の値が残る。"
    ],
    "leaveOut": ["while と break", "for-of と文字の判定", "問7・問8の答えのコード"]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "残りの発送便",
      "code": ["// 発送便の残りは 3、2、1 と減る", "// 同じ作業を 0 回頼まれることもある"],
      "beats": [
        {
          "say": "残りの発送便を、三から一へ数えられますか。",
          "type": [0]
        },
        {
          "say": "作業がゼロ回なら、何が起こるでしょうか。",
          "type": [1]
        }
      ]
    },
    {
      "id": "down",
      "kind": "code",
      "role": "point",
      "title": "一ずつ減らす",
      "code": [
        "// 履歴 log を入れ直せる変数として作り、空の文字列を入れる",
        "let log = \"\";",
        "// i を 3 から 1 まで 1 ずつ減らしながらくり返す",
        "for (let i = 3; i >= 1; i--) {",
        "  // log の後ろに便の番号と空白をつなげる",
        "  log += `${i}便 `;",
        "  // くり返す中身はここまで",
        "}"
      ],
      "beats": [
        {
          "say": "空の文字列は、まだ文字がない値です。",
          "type": [0, 1],
          "set": {
            "log": "\"\""
          }
        },
        {
          "say": "三から始め、一以上の間くり返します。",
          "type": [2, 3],
          "set": {
            "i": "3"
          }
        },
        {
          "say": "文字列にも、足して入れ直す書き方が使えます。",
          "type": [4, 5, 6, 7],
          "calc": {
            "on": "log",
            "expr": "\"\" に \"3便 \" をつなぐ",
            "result": "\"3便 \""
          }
        },
        {
          "say": "二つのマイナスで一減らし、次の便を足します。",
          "set": {
            "i": "2"
          },
          "calc": {
            "on": "log",
            "expr": "\"3便 \" に \"2便 \" をつなぐ",
            "result": "\"3便 2便 \""
          }
        },
        {
          "say": "一の便も足すと、三つの便が並びます。",
          "set": {
            "i": "1"
          },
          "calc": {
            "on": "log",
            "expr": "\"3便 2便 \" に \"1便 \" をつなぐ",
            "result": "\"3便 2便 1便 \""
          }
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["i", "log"]
      },
      "point": 1
    },
    {
      "id": "bound",
      "kind": "code",
      "role": "point",
      "title": "一も含み、ゼロで止まる",
      "code": ["// i >= 1 は、一以上かを比べる", "// i が 0 になると中身を実行しない"],
      "beats": [
        {
          "say": "以上も、同じ数を含む比べ方です。",
          "type": [0],
          "range": [1, 3]
