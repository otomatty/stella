    {
      "id": "repeat",
      "kind": "code",
      "role": "point",
      "title": "ゼロから数える",
      "code": [
        "// 便の数 n を作り、3 を入れる",
        "const n = 3;",
        "// 印 stamps を入れ直せる変数として作り、空の文字列を入れる",
        "let stamps = \"\";",
        "// i を 0 から n の手前まで 1 ずつ増やしながらくり返す",
        "for (let i = 0; i < n; i++) {",
        "  // stamps の後ろに済をつなげる",
        "  stamps += \"済\";",
        "  // くり返す中身はここまで",
        "}"
      ],
      "beats": [
        {
          "say": "今度は、発送済みの印を三回付けます。",
          "type": [0, 1, 2, 3],
          "set": {
            "stamps": "\"\""
          }
        },
        {
          "say": "ゼロから始め、未満の条件を使います。",
          "type": [4, 5],
          "set": {
            "i": "0"
          }
        },
        {
          "say": "ゼロの回で、最初の印が入ります。",
          "type": [6, 7, 8, 9],
          "calc": {
            "on": "stamps",
            "expr": "\"\" に \"済\" をつなぐ",
            "result": "\"済\""
          }
        },
        {
          "say": "一の回で、二つ目の印を足します。",
          "set": {
            "i": "1"
          },
          "calc": {
            "on": "stamps",
            "expr": "\"済\" に \"済\" をつなぐ",
            "result": "\"済済\""
          }
        },
        {
          "say": "二の回で、三つ目の印を足します。",
          "set": {
            "i": "2"
          },
          "calc": {
            "on": "stamps",
            "expr": "\"済済\" に \"済\" をつなぐ",
            "result": "\"済済済\""
          }
        },
        {
          "say": "三になると終了し、三回分の印が残ります。",
          "set": {
            "i": "3"
          }
        }
      ],
      "panel": {
        "kind": "values",
        "items": ["i", "stamps"]
      },
      "point": 2
    },
    {
      "id": "zero",
      "kind": "code",
      "role": "point",
      "title": "回数がゼロなら",
      "code": [
        "// 回数 n を作り、0 を入れる",
        "const n = 0;",
        "// ポイント points を入れ直せる変数として作り、10 を入れる",
        "let points = 10;",
        "// i を 0 から n の手前まで 1 ずつ増やしながらくり返す",
        "for (let i = 0; i < n; i++) {",
        "  // points に 2 を掛ける",
        "  points *= 2;",
        "  // くり返す中身はここまで",
        "}",
        "// 間違いの条件は、0 <= 0"
      ],
      "beats": [
        {
          "say": "未満は、同じ数を含みません。",
          "type": [0, 1, 2, 3, 4, 5],
          "set": {
            "i": "0",
            "points": "10"
          }
        },
        {
          "say": "ゼロ未満のゼロはないので、中身を飛ばします。",
          "type": [6, 7, 8, 9],
          "plot": {
            "at": 0,
            "label": "0 < 0 は false"
