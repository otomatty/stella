{
  "schema": 1,
  "brief": {
    "goal": "値と return を読み、定数と関数の戻り値に推論される型を説明できる。",
    "stuck": "型注釈を消すと型もなくなると考え、何を省けるか判断できない。",
    "points": [
      "const と let は値から型が決まり、export const で定数を公開できる。",
      "引数の型を残して戻り値の型を省くと、return から型が決まる。",
      "複数の return は型をまとめ、undefined も候補になる。"
    ],
    "leaveOut": [
      "関数の引数の型が必要な理由の解答",
      "添字と else if の説明",
      "問1から応用までの答えのコード"
    ]
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "code",
      "role": "hook",
      "title": "型を書かない送料",
