{
  "schema": 1,
  "brief": {
    "goal": "一問ずつ確認して提出する順番と、守るルールを説明できる。",
    "stuck": "どのファイルを直すのか、確認と提出は何が違うのか分からない。",
    "points": [
      "一問一ファイルで、問題の編集する場所だけを書く。",
      "一問ずつ確認し、通ったら提出して次の問題へ進む。",
      "生成 AI のコード作成や自動補完を使わず、テストと設定を変えない。"
    ],
    "leaveOut": [
      "サーバーはコードを実行せず手元で通ったという申告を受ける仕組み",
      "CLI の導入と操作",
      "TypeScript の文法の詳しい説明",
      "練習問題の答えのコード"
    ]
  },
  "boards": {
    "files": {
      "cols": 3,
      "rows": 1,
      "zones": [
        {
          "id": "task",
          "label": "課題フォルダー",
          "icon": "folder",
          "tone": "violet",
          "cells": [1, 1, 3, 1]
        }
      ],
      "nodes": [
        {
          "id": "source",
          "label": "src/ 問題",
          "icon": "folder",
          "at": [1, 1]
        },
        {
          "id": "tests",
          "label": "tests/",
          "icon": "folder",
          "at": [2, 1]
        },
        {
          "id": "config",
          "label": "設定ファイル",
          "icon": "file",
          "at": [3, 1]
        }
      ]
    },
    "flow": {
      "cols": 4,
      "rows": 2,
      "nodes": [
        {
          "id": "write",
          "label": "書く",
          "icon": "write",
          "at": [1, 1]
        },
        {
          "id": "save",
          "label": "保存",
          "icon": "save",
          "at": [2, 1]
        },
        {
          "id": "check",
          "label": "確認",
          "icon": "check",
          "at": [3, 1]
        },
        {
          "id": "submit",
          "label": "提出",
          "icon": "send",
          "at": [3, 2]
        },
        {
          "id": "fix",
          "label": "通らなければ直す",
          "icon": "repeat",
          "at": [4, 1]
        },
        {
          "id": "next",
          "label": "次の問題",
          "icon": "file",
          "at": [4, 2]
        }
      ],
      "links": [
        {
          "id": "to-save",
          "from": "write",
          "to": "save"
        },
        {
          "id": "to-check",
          "from": "save",
          "to": "check"
        },
        {
          "id": "failed",
          "from": "check",
          "to": "fix"
        },
        {
          "id": "retry",
          "from": "fix",
          "to": "save",
          "route": "over"
        },
        {
          "id": "passed",
          "from": "check",
          "to": "submit",
          "label": "通った"
        },
        {
          "id": "to-next",
          "from": "submit",
          "to": "next"
        }
      ]
    },
    "rules": {
      "cols": 3,
      "rows": 2,
      "zones": [
        {
          "id": "allowed",
          "label": "してよいこと",
          "tone": "blue",
          "cells": [1, 1, 1, 2]
        },
        {
          "id": "prohibited",
          "label": "しないこと",
          "tone": "violet",
          "cells": [2, 1, 2, 2]
        }
      ],
      "nodes": [
        {
          "id": "ask",
          "label": "説明を聞く",
          "icon": "question",
          "at": [1, 1]
        },
        {
          "id": "generate",
          "label": "AI に書かせる",
          "icon": "ai",
          "at": [2, 1]
        },
        {
          "id": "complete",
          "label": "AI の自動補完",
          "icon": "editor",
          "at": [3, 1]
        },
        {
          "id": "change-tests",
          "label": "テストの書き換え",
          "icon": "check",
          "at": [2, 2]
        },
        {
          "id": "change-config",
          "label": "設定の書き換え",
          "icon": "file",
          "at": [3, 2]
        }
      ]
    },
    "recap": {
      "cols": 3,
      "rows": 1,
      "nodes": [
        {
          "id": "write",
          "label": "自分で書く",
          "icon": "write",
          "at": [1, 1]
        },
        {
          "id": "check",
          "label": "確認する",
          "icon": "check",
          "at": [2, 1]
        },
        {
          "id": "submit",
          "label": "提出する",
          "icon": "send",
          "at": [3, 1]
        }
      ],
      "links": [
        {
          "id": "to-check",
          "from": "write",
          "to": "check"
        },
        {
          "id": "to-submit",
          "from": "check",
          "to": "submit",
          "label": "通った"
        }
      ]
    }
  },
  "scenes": [
    {
      "id": "hook",
      "kind": "board",
      "role": "hook",
      "title": "どのファイルを直す？",
      "board": "files",
      "beats": [
        {
          "say": "課題のフォルダーには、いろいろなファイルが入っています。",
          "show": ["task"]
        },
        {
          "say": "どれを直せばよいでしょうか？",
          "show": ["source", "tests", "config"]
        },
        {
          "say": "提出はいつすればよいでしょうか？",
          "mark": [
            {
              "on": "task",
              "kind": "question"
            }
          ]
        }
      ]
    },
    {
      "id": "file",
      "kind": "board",
      "role": "point",
      "title": "一問につき一つのファイル",
      "board": "files",
      "point": 1,
      "reset": true,
      "beats": [
        {
          "say": "ドリルは一問につき一つのファイルです。",
          "show": ["task", "source"]
        },
        {
          "say": "問題のファイルは「ここに書く」の場所だけを編集します。",
          "mark": [
            {
              "on": "source",
              "kind": "check"
            }
          ]
        },
        {
          "say": "テストのファイルはそのままにします。",
          "mark": [
            {
              "on": "tests",
              "kind": "cross"
            }
          ],
          "show": ["tests"]
        },
        {
          "say": "設定ファイルもそのままにします。",
          "mark": [
            {
              "on": "config",
              "kind": "cross"
            }
          ],
          "show": ["config"]
        }
      ]
    },
    {
      "id": "loop",
      "kind": "board",
      "role": "point",
      "title": "書いたら手元で確認",
      "board": "flow",
      "point": 2,
      "beats": [
        {
          "say": "まず一問だけ書きます。",
          "show": ["write"]
        },
        {
          "say": "書けたら保存します。",
          "show": ["save", "to-save"],
          "travel": {
            "along": ["to-save"]
          }
        },
        {
          "say": "保存したら「課題を確認する」を使います。",
          "show": ["check", "to-check"],
          "travel": {
            "along": ["to-check"]
          }
        },
        {
          "say": "通らなければ、結果を読んで直します。",
          "show": ["fix", "failed"],
          "travel": {
            "along": ["failed"]
          }
        },
        {
          "say": "直したら、保存してもう一度確認します。",
          "show": ["retry"],
          "travel": {
            "along": ["retry", "to-check"]
          }
        }
      ]
    },
    {
      "id": "submit",
      "kind": "board",
      "role": "point",
      "title": "通ったら提出する",
      "board": "flow",
      "point": 2,
      "beats": [
        {
          "say": "確認が通ったら、課題のパネルから提出します。",
          "show": ["submit", "passed"],
          "travel": {
            "along": ["passed"]
          }
        },
        {
          "say": "次の問題に進むのは、提出してからです。",
          "show": ["next", "to-next"],
          "travel": {
            "along": ["to-next"]
          }
        }
      ]
    },
    {
      "id": "rules",
      "kind": "board",
      "role": "point",
      "title": "守るルール",
      "board": "rules",
      "point": 3,
      "beats": [
        {
          "say": "分からないところは、説明を聞いても大丈夫です。",
          "mark": [
            {
              "on": "ask",
              "kind": "check"
            }
          ],
          "show": ["allowed", "ask"]
        },
        {
          "say": "生成 AI にコードを書かせてはいけません。",
          "mark": [
            {
              "on": "generate",
              "kind": "cross"
            }
          ],
          "show": ["prohibited", "generate"]
        },
        {
          "say": "始める前に AI の自動補完を切ります。",
          "mark": [
            {
              "on": "complete",
              "kind": "cross"
            }
          ],
          "show": ["complete"]
        },
        {
          "say": "テストのファイルは書き換えません。",
          "mark": [
            {
              "on": "change-tests",
              "kind": "cross"
            }
          ],
          "show": ["change-tests"]
        },
        {
          "say": "設定ファイルもそのままにしましょう。",
          "mark": [
            {
              "on": "change-config",
              "kind": "cross"
            }
          ],
          "show": ["change-config"]
        }
      ]
    },
    {
      "id": "recap",
      "kind": "board",
      "role": "recap",
      "title": "一問ずつ進める",
      "board": "recap",
      "beats": [
        {
          "say": "問題のファイルは自分で書きます。",
          "show": ["write"]
        },
        {
          "say": "書けたら手元で確認します。",
          "show": ["check", "to-check"],
          "travel": {
            "along": ["to-check"]
          }
        },
        {
          "say": "通ったら提出してから次へ進みましょう。",
          "show": ["submit", "to-submit"],
          "travel": {
            "along": ["to-submit"]
          }
        }
      ]
    }
  ]
}
