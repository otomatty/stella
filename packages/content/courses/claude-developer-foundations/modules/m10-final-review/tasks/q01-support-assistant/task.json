    "rubric": [
      {
        "id": "schema-placement",
        "criterion": "ツールの入力の形を strict を付けた input_schema で、最後の答えの形を output_config.format の JSON スキーマで決め、毎回のリクエストに両方を入れている",
        "required": true
      },
      {
        "id": "tool-loop",
        "criterion": "tool_use のときに応答の content を thinking ブロックも含めてそのまま assistant の発言に足し、すべての tool_result を tool_use_id で結んで 1 つの user の発言で返し、知らないツールと例外を is_error の結果にしている",
        "required": true
      },
      {
        "id": "stop-reason-vs-error",
        "criterion": "stop_reason の値ごとの分岐と、create が投げたエラーの扱いを分け、切れた応答を JSON として読まず、429・500 以上のエラーをアプリで重ねて送り直さずに返している",
        "required": true
      }
    ],
    "escalateWhen": []
  },
