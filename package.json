{
  "name": "falcon-informal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun --filter=@stella/web dev",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "dev:api": "bun --filter=@stella/api dev",
    "build": "bun run --filter=@stella/web build && bun run --filter=informal build",
    "preview": "bun --filter=@stella/web preview",
    "preview:build": "bun run --filter=@stella/web build && bun run --filter=@stella/web preview",
    "typecheck": "bun --filter '@stella/*' typecheck && bun --filter informal typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "content:check": "bun run --filter=@stella/content check:ci",
    "content:upload:remote": "bun run --filter=@stella/content upload:remote",
    "content:pdf:sync": "bun run --filter=@stella/content pdf:sync",
    "content:pdf:sync:remote": "bun run --filter=@stella/content pdf:sync:remote",
    "content:upload:thumbnails:remote": "bun run --filter=@stella/content upload:thumbnails:remote",
    "content:state:check:remote": "bun run --filter=@stella/content state:check:remote",
    "content:state:save:remote": "bun run --filter=@stella/content state:save:remote",
    "content:state:reset:remote": "bun run --filter=@stella/content state:reset:remote",
    "deploy:api": "bun run --filter=@stella/api deploy",
    "deploy:web": "bun run --filter=@stella/web build && bun run --filter=@stella/web deploy",
    "smoke:d1": "bun run --filter=@stella/api smoke",
    "smoke:core": "bun run --filter=@stella/api smoke:core",
    "r2:orphans": "bun run --filter=@stella/api r2:orphans",
    "db:generate": "bun run --filter=@stella/api db:generate",
    "db:migrate": "bun run --filter=@stella/api db:migrate",
    "db:migrate:remote": "bun run --filter=@stella/api db:migrate:remote",
    "db:seed": "bun run --filter=@stella/api db:seed",
    "db:seed:remote": "bun run --filter=@stella/api db:seed:remote",
    "db:seed:remote:content": "bun run --filter=@stella/api db:seed:remote:content"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@vitest/coverage-v8": "5.0.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "vite": "8.2.2",
    "pdfjs-dist": "6.3.289"
  }
}
