{
  "name": "falcon-informal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun --filter=@falcon/web dev",
    "dev:api": "bun --filter=@falcon/api dev",
    "build": "bun --filter '@falcon/*' build",
    "preview": "bun --filter=@falcon/web preview",
    "typecheck": "bun --filter '@falcon/*' typecheck",
    "deploy:api": "bun run --filter=@falcon/api deploy",
    "deploy:web": "bun run build && bun run --filter=@falcon/web deploy",
    "smoke:d1": "bun run --filter=@falcon/api smoke",
    "db:generate": "bun run --filter=@falcon/api db:generate",
    "db:migrate": "bun run --filter=@falcon/api db:migrate",
    "db:migrate:remote": "bun run --filter=@falcon/api db:migrate:remote",
    "db:seed": "bun run --filter=@falcon/api db:seed",
    "db:seed:remote": "bun run --filter=@falcon/api db:seed:remote"
  }
}
