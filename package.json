{
  "name": "falcon-informal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun --filter=@falcon/web dev",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "dev:api": "bun --filter=@falcon/api dev",
    "build": "bun --filter '@falcon/*' build && bun --filter informal build",
    "preview": "bun --filter=@falcon/web preview",
    "preview:build": "bun run --filter=@falcon/web build && bun run --filter=@falcon/web preview",
    "typecheck": "bun --filter '@falcon/*' typecheck && bun --filter informal typecheck",
    "test": "vitest run",
    "content:check": "bun run --filter=@falcon/content check:ci",
    "content:upload:remote": "bun run --filter=@falcon/content upload:remote",
    "content:upload:thumbnails:remote": "bun run --filter=@falcon/content upload:thumbnails:remote",
    "deploy:api": "bun run --filter=@falcon/api deploy",
    "deploy:web": "bun run build && bun run --filter=@falcon/web deploy",
    "smoke:d1": "bun run --filter=@falcon/api smoke",
    "smoke:core": "bun run --filter=@falcon/api smoke:core",
    "r2:orphans": "bun run --filter=@falcon/api r2:orphans",
    "db:generate": "bun run --filter=@falcon/api db:generate",
    "db:migrate": "bun run --filter=@falcon/api db:migrate",
    "db:migrate:remote": "bun run --filter=@falcon/api db:migrate:remote",
    "db:seed": "bun run --filter=@falcon/api db:seed",
    "db:seed:remote": "bun run --filter=@falcon/api db:seed:remote",
    "db:seed:remote:content": "bun run --filter=@falcon/api db:seed:remote:content"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "vitest": "3.2.6"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
