{
  "name": "falcon-informal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun --filter=@falcon/web dev",
    "dev:api": "bun --filter=@falcon/api dev",
    "build": "bun --filter '@falcon/*' build",
    "preview": "bun --filter=@falcon/web preview",
    "typecheck": "bun --filter '@falcon/*' typecheck",
    "seed:fixtures": "bun --env-file=apps/web/.env.local run packages/shared/scripts/seed-from-fixtures.ts",
    "seed:fixtures:sql": "bun run packages/shared/scripts/export-seed-sql.ts",
    "smoke:neon": "bun run --filter=@falcon/api smoke",
    "db:generate": "bun run --filter=@falcon/api db:generate",
    "db:migrate": "bun run --filter=@falcon/api db:migrate"
  }
}
