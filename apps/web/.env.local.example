# --- Cloudflare スタック --- gitignore 対象。
# 日常開発では VITE_SERVER_URL を必ず設定する（実データ経路）。
# 未設定のまま起動すると API を使わず fixtures / モックログインのデモ経路になる。
# Hono API (Cloudflare Workers)
VITE_SERVER_URL=http://127.0.0.1:8787

# Cloudflare R2 公開ベース URL (教材 PDF/動画)
VITE_MATERIALS_BASE_URL=

# サポートページ (/support) に表示する問い合わせ先メール。 未設定なら既定値を使用。
VITE_SUPPORT_EMAIL=saedgewell@gmail.com

# 認証の方式。 clerk = Clerk (本番)、 dev-token = 開発用 JWT を貼り付ける (ローカル)。
# 未指定なら `vite dev` は dev-token、 build (preview を含む) は clerk。 ローカルで
# `bun run build && bun run preview` を試すときは dev-token にする (ローカルの API に Clerk は無い)。
# VITE_AUTH_MODE=dev-token
# Clerk の開発環境で試すときだけ (API の .dev.vars にも CLERK_SECRET_KEY を入れる)。
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# 講師・管理者用の入口 (Cloudflare Access で守ったオリジン)。
# VITE_STAFF_ORIGIN=
