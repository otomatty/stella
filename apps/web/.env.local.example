# Supabase — 教材ファイル (PDF/動画) の配信 + CMS DB / 認証 (Magic Link) に使用
# クラウドプロジェクト例: falcon-informal → https://jpanvybfaukpgqtwjljl.supabase.co
# Dashboard → Settings → API Keys の Publishable key (`sb_publishable_...`) と Project URL を貼る
# https://supabase.com/docs/guides/getting-started/api-keys
# CMS の DB スキーマは supabase/migrations/ 配下の SQL を SQL Editor で順に適用する
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Workers API (`apps/api`) — AI チャットのオリジン (末尾スラッシュなし)
# ローカル: wrangler dev 既定は http://127.0.0.1:8787
VITE_SERVER_URL=http://127.0.0.1:8787

# Seed スクリプト用 (`bun run seed:fixtures`) — server 側のみで使用する。 ブラウザにはバンドルしない。
# Dashboard → Settings → API Keys の Secret key (`sb_secret_...`) を貼る
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
