# Supabase — 教材ファイル (PDF/動画) の配信 + CMS DB / 認証 (Magic Link) に使用
# Supabase Studio で `materials-public` バケット (public read) を作成して URL/anon key を貼る
# CMS の DB スキーマは supabase/migrations/ 配下の SQL を SQL Editor で順に適用する
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic — AI チャット (`/api/chat`) で参照される
# 既定モデルは claude-sonnet-4-6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Seed スクリプト用 (`bun run seed:fixtures`) — server 側のみで使用する。 ブラウザにはバンドルしない。
# Supabase ダッシュボード → Project Settings → API → service_role key を貼る
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
