# --- Neon 移行 (#neon) ---
# Cloudflare Workers API (`apps/api`) — フロントは全データアクセスをこの API 経由で行う。
# ローカル: wrangler dev 既定は http://127.0.0.1:8787 (末尾スラッシュなし)
VITE_SERVER_URL=http://127.0.0.1:8787

# Neon Auth のベース URL (Magic Link 送信先)。 Neon Console → Auth で取得。
VITE_NEON_AUTH_URL=

# Cloudflare R2 バケットの公開ベース URL (教材 PDF/動画の配信)。
# Dashboard → R2 → falcon-materials-public → Settings → Public Development URL (r2.dev)
# またはカスタムドメインを有効化してその URL を貼る。
# 例: https://pub-xxxx.r2.dev
VITE_MATERIALS_BASE_URL=
