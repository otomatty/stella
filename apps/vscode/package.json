{
  "name": "stella",
  "displayName": "STELLA",
  "publisher": "stella",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/otomatty/stella.git",
    "directory": "apps/vscode"
  },
  "description": "STELLA — VS Code extension for stage lessons and exercises",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onUri", "onView:stella.lessons", "onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "信頼していないフォルダーでは、課題の確認 (テストや npm の実行) をしません。",
      "restrictedConfigurations": ["stella.serverUrl", "stella.webUrl"]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stella",
          "title": "STELLA",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "stella": [
        {
          "id": "stella.lessons",
          "name": "カリキュラム"
        }
      ]
    },
    "commands": [
      {
        "command": "stella.connect",
        "title": "STELLA: Web で接続"
      },
      {
        "command": "stella.disconnect",
        "title": "STELLA: 切断"
      },
      {
        "command": "stella.refresh",
        "title": "STELLA: 再読み込み"
      },
      {
        "command": "stella.grade",
        "title": "STELLA: 採点を実行"
      },
      {
        "command": "stella.resetExercise",
        "title": "STELLA: 課題をリセット"
      },
      {
        "command": "stella.openInWeb",
        "title": "STELLA: Web で開く"
      },
      {
        "command": "stella.openLessonDoc",
        "title": "STELLA: ドキュメントを開く"
      },
      {
        "command": "stella.openLessonCode",
        "title": "STELLA: 演習を開く"
      },
      {
        "command": "stella.openNextLesson",
        "title": "STELLA: 次のレッスンへ"
      },
      {
        "command": "stella.submitExercise",
        "title": "STELLA: 採点した演習を提出する"
      },
      {
        "command": "stella.escalateToInstructor",
        "title": "STELLA: 講師に引き継ぐ"
      },
      {
        "command": "stella.runTask",
        "title": "STELLA: 課題を確認する"
      },
      {
        "command": "stella.diagnoseEnvironment",
        "title": "STELLA: 開発環境を診断する"
      },
      {
        "command": "stella.showRunLog",
        "title": "STELLA: 実行ログを表示する"
      },
      {
        "command": "stella.submitTask",
        "title": "STELLA: 課題を提出する"
      },
      {
        "command": "stella.consultTask",
        "title": "STELLA: 講師に相談する"
      },
      {
        "command": "stella.chooseTrainingFolder",
        "title": "STELLA: 学習フォルダーを選ぶ"
      },
      {
        "command": "stella.startFromFixedStart",
        "title": "STELLA: 固定した開始点から始める"
      },
      {
        "command": "stella.showTaskReadme",
        "title": "STELLA: 課題文を表示する",
        "icon": "$(preview)"
      },
      {
        "command": "stella.showTaskHelp",
        "title": "STELLA: ヒント・解答・レビューの結果を表示する"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stella.showTaskReadme",
          "when": "resourceFilename == README.md && resourcePath =~ /web-training/",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "fe-pseudo",
        "aliases": ["擬似言語 (基本情報 科目B)", "FE Pseudo", "fe-pseudo"],
        "extensions": [".fe"],
        "configuration": "./language-configuration/fe-pseudo.json"
      }
    ],
    "grammars": [
      {
        "language": "fe-pseudo",
        "scopeName": "source.fe-pseudo",
        "path": "./syntaxes/fe-pseudo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fe-pseudo",
        "path": "./snippets/fe-pseudo.json"
      }
    ],
    "configuration": {
      "properties": {
        "stella.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "scope": "application",
          "description": "STELLA の API のオリジン。ユーザー設定でだけ変えられる (開いたフォルダーの設定では変わらない)"
        },
        "stella.webUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5173",
          "scope": "application",
          "description": "STELLA の Web のオリジン。ユーザー設定でだけ変えられる"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@stella/code-runner": "workspace:*",
    "@stella/shared": "workspace:*",
    "parse5": "^8",
    "picomatch": "^4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4",
    "@types/vscode": "1.96.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
