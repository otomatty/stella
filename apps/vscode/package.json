{
  "name": "stella-lms",
  "displayName": "STELLA 研修",
  "publisher": "saedgewell",
  "version": "0.9.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/otomatty/stella.git",
    "directory": "apps/vscode"
  },
  "description": "STELLA の課題を VS Code で受け取り、手元で確かめて提出する拡張機能",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onUri", "onView:stella.lessons", "onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "信頼していないフォルダーでは、課題の確認 (テストや npm の実行) をしません。",
      "restrictedConfigurations": ["stella.serverUrl", "stella.webUrl"]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stella",
          "title": "STELLA",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "stella": [
        {
          "id": "stella.lessons",
          "name": "学習ガイド",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "stella.connect",
        "title": "STELLA: Web で接続"
      },
      {
        "command": "stella.disconnect",
        "title": "STELLA: 切断"
      },
      {
        "command": "stella.refresh",
        "title": "STELLA: 再読み込み"
      },
      {
        "command": "stella.grade",
        "title": "STELLA: 確認を実行"
      },
      {
        "command": "stella.resetExercise",
        "title": "STELLA: 課題をリセット"
      },
      {
        "command": "stella.openInWeb",
        "title": "STELLA: Web で開く"
      },
      {
        "command": "stella.openLessonDoc",
        "title": "STELLA: ドキュメントを開く"
      },
      {
        "command": "stella.openLessonCode",
        "title": "STELLA: 課題を開く"
      },
      {
        "command": "stella.openNextLesson",
        "title": "STELLA: 次の教材へ"
      },
      {
        "command": "stella.submitExercise",
        "title": "STELLA: 確認を通過した課題を提出する"
      },
      {
        "command": "stella.escalateToInstructor",
        "title": "STELLA: 管理者に引き継ぐ"
      },
      {
        "command": "stella.runTask",
        "title": "STELLA: 課題を確認する",
        "icon": "$(beaker)"
      },
      {
        "command": "stella.showLastResult",
        "title": "STELLA: 前回の確認の結果を表示する"
      },
      {
        "command": "stella.diagnoseEnvironment",
        "title": "STELLA: 開発環境を診断する"
      },
      {
        "command": "stella.showRunLog",
        "title": "STELLA: 実行ログを表示する"
      },
      {
        "command": "stella.submitTask",
        "title": "STELLA: 課題を提出する",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "stella.consultTask",
        "title": "STELLA: 管理者に相談する"
      },
      {
        "command": "stella.chooseTrainingFolder",
        "title": "STELLA: 学習フォルダーを選ぶ"
      },
      {
        "command": "stella.startFromFixedStart",
        "title": "STELLA: 固定した開始点から始める"
      },
      {
        "command": "stella.showTaskReadme",
        "title": "STELLA: 課題文を表示する",
        "icon": "$(book)"
      },
      {
        "command": "stella.showTaskHelp",
        "title": "STELLA: ヒント・解答・レビューの結果を表示する"
      },
      {
        "command": "stella.openWalkthrough",
        "title": "STELLA: 課題の進め方を見る"
      }
    ],
    "walkthroughs": [
      {
        "id": "stella.gettingStarted",
        "title": "STELLA の課題の進め方",
        "description": "課題を受け取ってから合格するまでの 4 つの操作です。",
        "steps": [
          {
            "id": "open",
            "title": "課題を開く",
            "description": "Web の課題で「VS Code で開く」を押すと、学習フォルダーに課題が準備されます。左に編集するファイル、右に課題文が並びます。\n[学習ガイドを開く](command:stella.lessons.focus)",
            "completionEvents": ["onContext:stella.inTask"],
            "media": {
              "svg": "media/walkthrough/open.svg",
              "altText": "左の編集するファイルと右の課題文を強調した VS Code の画面"
            }
          },
          {
            "id": "edit",
            "title": "ファイルを編集して保存する",
            "description": "左の列のファイルを書き換えて保存します。作るものと条件は、右の列の課題文に書いてあります。\n[課題文を表示する](command:stella.showTaskReadme)",
            "completionEvents": ["onCommand:stella.showTaskReadme"],
            "media": {
              "svg": "media/walkthrough/edit.svg",
              "altText": "コードを書く左側のエディターを強調した VS Code の画面"
            }
          },
          {
            "id": "submit",
            "title": "提出する",
            "description": "「提出する」を押すと、テストなどの確認が自動で走ります。通ったら振り返りを書いて送ります。通らなければ何も送らず、直すところが出ます。\n[提出する](command:stella.submitTask)",
            "completionEvents": ["onCommand:stella.submitTask"],
            "media": {
              "svg": "media/walkthrough/submit.svg",
              "altText": "エディター右上とステータスバーの提出ボタンを強調した VS Code の画面"
            }
          },
          {
            "id": "review",
            "title": "レビューの結果を見る",
            "description": "提出すると AI がレビューし、必要なときは管理者が確認します。結果は課題文のパネルと Web の通知に届きます。合格すると、この課題は完了です。\n[レビューの結果を表示する](command:stella.showTaskHelp)",
            "completionEvents": ["onCommand:stella.showTaskHelp"],
            "media": {
              "svg": "media/walkthrough/review.svg",
              "altText": "右の課題文の進行バーで最後のレビューの段を強調した VS Code の画面"
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stella.submitTask",
          "when": "stella.inTask && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "stella.runTask",
          "when": "stella.inTask && resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "stella.showTaskReadme",
          "when": "stella.inTask && resourceScheme == file",
          "group": "navigation@3"
        }
      ]
    },
    "languages": [
      {
        "id": "fe-pseudo",
        "aliases": ["擬似言語 (基本情報 科目B)", "FE Pseudo", "fe-pseudo"],
        "extensions": [".fe"],
        "configuration": "./language-configuration/fe-pseudo.json"
      }
    ],
    "grammars": [
      {
        "language": "fe-pseudo",
        "scopeName": "source.fe-pseudo",
        "path": "./syntaxes/fe-pseudo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fe-pseudo",
        "path": "./snippets/fe-pseudo.json"
      }
    ],
    "configuration": {
      "properties": {
        "stella.serverUrl": {
          "type": "string",
          "default": "https://stella.saedgewell.workers.dev",
          "scope": "application",
          "description": "STELLA の API のオリジン。ユーザー設定でだけ変えられる (開いたフォルダーの設定では変わらない)。未設定なら本番、F5 の開発ホストでは http://127.0.0.1:8787"
        },
        "stella.webUrl": {
          "type": "string",
          "default": "https://stella.saedgewell.workers.dev",
          "scope": "application",
          "description": "STELLA の Web のオリジン。ユーザー設定でだけ変えられる。未設定なら本番、F5 の開発ホストでは http://127.0.0.1:5173"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies --readme-path MARKETPLACE.md"
  },
  "dependencies": {
    "@stella/code-runner": "workspace:*",
    "@stella/shared": "workspace:*",
    "parse5": "^8",
    "picomatch": "^4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4",
    "@types/vscode": "1.96.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
