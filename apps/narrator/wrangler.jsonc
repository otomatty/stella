{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stella-narrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stella-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../api/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "stella-library-private"
    }
  ],
  "workflows": [
    {
      "binding": "BOOK_WORKFLOW",
      "name": "stella-library-book",
      "class_name": "BookWorkflow"
    },
    {
      "binding": "AUDIO_WORKFLOW",
      "name": "stella-library-audio",
      "class_name": "AudioWorkflow"
    }
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "LIBRARY_PROCESSING_ENABLED": "0",
    "LIBRARY_OCR_PAGES_PER_USER_MONTH": "2000",
    "LIBRARY_OCR_PAGES_PER_TENANT_MONTH": "20000",
    "OCR_MODEL": "gemini-3.8-flash",
    "TTS_MODEL": "gemini-3.8-flash-tts",
    "TTS_VOICE": "Kore",
    "TTS_LANGUAGE": "ja-JP"
  },
  "triggers": {
    "crons": ["0 * * * *", "30 * * * *"]
  }
}
