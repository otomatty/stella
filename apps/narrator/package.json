{
  "name": "@stella/narrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --persist-to ../api/.wrangler/state",
    "types": "wrangler types worker-configuration.d.ts --env-interface NarratorEnv --strict-vars=false --include-runtime=false",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "bun run build && vitest run --config vitest.config.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@stella/book-core": "workspace:*",
    "@stella/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5",
    "wrangler": "4.152.0",
    "miniflare": "5.20261006.1-alpha",
    "vitest": "5.0.3",
    "esbuild": "^0.28.1",
    "hono": "^4.13.12",
    "pdf-lib": "^1.17.1",
    "@cloudflare/workers-types": "5.20261026.1"
  }
}
