{
  "name": "@stella/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STELLA — Hono API on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply stella-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stella-db --remote",
    "db:seed": "bun run scripts/seed-d1.ts",
    "db:seed:remote": "bun run scripts/seed-d1.ts --remote",
    "db:seed:remote:content": "bun run scripts/seed-d1.ts --remote --content-only",
    "smoke": "bun run scripts/d1-smoke.ts",
    "smoke:core": "bun run scripts/core-loop-smoke.ts",
    "ai-review:eval": "bun run scripts/ai-review-eval.ts",
    "ai-review:replay": "bun run scripts/ai-review-replay.ts",
    "r2:orphans": "bun run scripts/r2-orphans.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@stella/shared": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
