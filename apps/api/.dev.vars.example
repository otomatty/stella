# wrangler dev 用。 `.dev.vars` にコピーして値を埋める (gitignore 対象)。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ISOLATE_MEMORY_LIMIT=32

# 開発モード (1 / true で有効)。ローカル開発専用 — 本番には設定しない。
# 右下の FAB でオン/オフできる。オンのとき島を全配信し、霧の星の名前もぼかさない。
# 解放条件はそのまま (見えるだけで locked の星は開かない)。
# DEV_MODE=1

# --- Cloudflare スタック (D1 + Google OAuth / JWT) ---
# JWT 署名用シークレット (本番は `wrangler secret put AUTH_JWT_SECRET`)。
AUTH_JWT_SECRET=dev-only-change-me-in-production

# Google OAuth (Cloud Console → 認可済みリダイレクト URI に
#   http://127.0.0.1:8787/api/auth/google/callback を追加)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 教材アップロード (Cloudflare R2) は wrangler.toml の [[r2_buckets]] でバインド。
# 公開読み取り URL は Dashboard で r2.dev / カスタムドメインを有効化し、
# apps/web/.env.local の VITE_MATERIALS_BASE_URL に設定する。

INVITE_REDIRECT_URL=http://localhost:5173

# Workers AI (面談対策の質問読み上げ生成 / 回答文字起こし)。
# Cloudflare Dashboard で「Workers AI (読み取り+実行)」権限の API トークンを作成して設定。
# 未設定でも API は起動し、 音声エンドポイントだけ 503 になる。
# AI_GATEWAY_ID + AI_GATEWAY_CF_API_TOKEN があればそちらを優先し Gateway 経由になる。
WORKERS_AI_API_TOKEN=

# 質問読み上げ (未設定なら Grok TTS / 声 eve / 言語 ja)。
# Grok TTS は AI Gateway の Unified Billing で呼ぶため、 AI_GATEWAY_ID と
# AI_GATEWAY_CF_API_TOKEN が必要 (xAI 側の API キーは不要)。
# Workers AI の TTS は日本語非対応なので既定にはしない。
# INTERVIEW_TTS_MODEL=grok-tts        # 他: @cf/myshell-ai/melotts, openai/tts-1
# INTERVIEW_TTS_VOICE=eve             # Grok: eve / ara / rex / sal / leo
# INTERVIEW_TTS_LANG=ja               # BCP-47。 "auto" で自動判定

# --- AI Gateway (Issue #204) ---
# wrangler.toml [vars] CLOUDFLARE_ACCOUNT_ID と同値。 account_id だけでは Workers ランタイムに渡らない。
CLOUDFLARE_ACCOUNT_ID=
# 例: stella-ai。未設定 = Anthropic 直叩き。
AI_GATEWAY_ID=
# chat / review-draft プロバイダ (既定 anthropic)。Grok 利用時は gateway 必須。
# CHAT_PROVIDER=grok
# CHAT_MODEL=grok-4.6
# Workers AI / AI Gateway REST 専用トークン (Account > Workers AI Read 等。deploy 用 CLOUDFLARE_API_TOKEN とは別)。
# wrangler secret put AI_GATEWAY_CF_API_TOKEN
AI_GATEWAY_CF_API_TOKEN=
