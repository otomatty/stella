{
  "accountId": "175c04a4465bcc9815b21176a852f0c0",
  "healthOrigin": "https://stella-api.saedgewell.workers.dev",
  "github": {
    "variables": ["VITE_SERVER_URL", "VITE_MATERIALS_BASE_URL"],
    "secrets": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "ANTHROPIC_API_KEY",
      "PDF_KEY_SALT"
    ],
    "optionalSecrets": ["PDF_KEY_SALT"]
  },
  "workerSecrets": {
    "api": ["AUTH_JWT_SECRET", "GOOGLE_CLIENT_SECRET", "ANTHROPIC_API_KEY"],
    "narrator": ["GEMINI_API_KEY"]
  },
  "resources": {
    "database": {
      "binding": "DB",
      "name": "stella-db"
    },
    "libraryBucket": {
      "apiBinding": "LIBRARY_BUCKET",
      "narratorBinding": "BUCKET",
      "name": "stella-library-private"
    },
    "narrator": {
      "binding": "NARRATOR",
      "service": "stella-narrator",
      "entrypoint": "Narrator"
    }
  },
  "health": {
    "ok": true,
    "googleOAuthConfigured": true,
    "jwtConfigured": true,
    "libraryEnabled": true,
    "narratorAvailable": true,
    "narratorGeminiConfigured": true,
    "processingAvailable": true,
    "aiReviewConfigured": true,
    "devModeAvailable": false
  }
}
